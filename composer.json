{
  "name": "shinning/php8-hotel-landing",
  "description": "Shinning Hotel — PHP 8 MVC CMS and booking WebUI",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/Helpers/url.php",
      "app/Helpers/view.php",
      "app/Helpers/auth.php",
      "app/Helpers/csrf.php",
      "app/Helpers/escape.php",
      "app/Helpers/slug.php",
      "app/Helpers/validation.php",
      "app/Helpers/pagination.php",
      "app/Helpers/amenities.php",
      "app/Helpers/rooms.php",
      "app/Helpers/booking.php",
      "app/Helpers/seo.php",
      "app/Helpers/lang.php"
    ]
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "scripts": {
    "test": "phpunit"
  }
}
