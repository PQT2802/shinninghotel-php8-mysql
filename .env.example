APP_NAME="Shinning Hotel"
APP_ENV=local
# Production: set APP_ENV=production and APP_DEBUG=false
APP_DEBUG=true
APP_URL=http://localhost:8000

# Docker MySQL (docker compose up -d): user shinning / pass shinning
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shinning_hotel
DB_USERNAME=shinning
DB_PASSWORD=shinning

SESSION_NAME=shinning_hotel_session
CSRF_TOKEN_NAME=_csrf_token
UPLOAD_MAX_SIZE_MB=5

# Brand
HOTEL_BRAND=Shinning
HOTEL_SLOGAN="Where Every Stay Shines"

# Mail (PHP mail() — enable on server with sendmail/SMTP configured)
MAIL_ENABLED=false
MAIL_FROM_ADDRESS=noreply@shinning.com
MAIL_FROM_NAME="Shinning Hotel"
MAIL_REPLY_TO=reservations@shinning.com
