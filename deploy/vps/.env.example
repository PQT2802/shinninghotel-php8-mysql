# Copy to VPS: /opt/apps/shinninghotel/.env
# DB_PASSWORD must match MYSQL_PASSWORD in docker-compose.yml

APP_NAME="Shinning Hotel"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://YOUR_VPS_IP:8081

DB_HOST=db
DB_PORT=3306
DB_DATABASE=shinninghotel_db
DB_USERNAME=shinninghotel_user
DB_PASSWORD=CHANGE_ME_SHINNINGHOTEL_PASSWORD

SESSION_NAME=shinninghotel_session
CSRF_TOKEN_NAME=_csrf_token
UPLOAD_MAX_SIZE_MB=5

HOTEL_BRAND=Shinning
HOTEL_SLOGAN="Where Every Stay Shines"

MAIL_ENABLED=false
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Shinning Hotel"
MAIL_REPLY_TO=reservations@example.com
